{
  "title": "SGLang — RoboQC Testbed",
  "uid": "roboqc-sglang",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-3h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Tokens per second (generation)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "rate(sglang_generation_tokens_total[1m])", "legendFormat": "{{model}}" }
      ]
    },
    {
      "id": 2,
      "title": "Time to first token (p50/p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(sglang_ttft_seconds_bucket[1m])) by (le, model))", "legendFormat": "p50 {{model}}" },
        { "expr": "histogram_quantile(0.95, sum(rate(sglang_ttft_seconds_bucket[1m])) by (le, model))", "legendFormat": "p95 {{model}}" }
      ]
    },
    {
      "id": 3,
      "title": "Running / waiting requests",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "expr": "sglang_num_running_requests", "legendFormat": "running {{model}}" },
        { "expr": "sglang_num_waiting_requests", "legendFormat": "waiting {{model}}" }
      ]
    },
    {
      "id": 4,
      "title": "KV cache utilization",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "sglang_token_usage", "legendFormat": "{{model}}" }
      ]
    }
  ]
}
