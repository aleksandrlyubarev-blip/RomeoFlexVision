{
  "title": "RHAEF Agents — RoboQC",
  "uid": "roboqc-agents",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-3h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "End-to-end latency (frame → command) p50/p95",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(rhaef_pipeline_latency_seconds_bucket[5m])) by (le, model))", "legendFormat": "p50 {{model}}" },
        { "expr": "histogram_quantile(0.95, sum(rate(rhaef_pipeline_latency_seconds_bucket[5m])) by (le, model))", "legendFormat": "p95 {{model}}" }
      ]
    },
    {
      "id": 2,
      "title": "Per-agent calls",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "expr": "sum(rate(rhaef_agent_calls_total[5m])) by (agent)", "legendFormat": "{{agent}}" }
      ]
    },
    {
      "id": 3,
      "title": "Critic retries",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "sum(rate(rhaef_critic_retries_total[5m]))", "legendFormat": "retries/s" }
      ]
    }
  ]
}
