#!/usr/bin/env bash
# Запускается при первой загрузке VM (Deep Learning VM, CUDA 12.4 + Docker предустановлены).
# Скачивает compose.gpu.yml из репозитория и поднимает SGLang + LangGraph-супервайзер.
set -euo pipefail

exec > >(tee -a /var/log/roboqc-startup.log) 2>&1
echo "[roboqc-startup] $(date -u) starting"

export DEBIAN_FRONTEND=noninteractive

# 1. Local SSD под /srv/models — единственный кэш GGUF/safetensors.
if lsblk -nlo NAME,MOUNTPOINT | grep -q '^nvme0n1[[:space:]]*$'; then
  echo "[roboqc-startup] formatting /dev/nvme0n1 as /srv/models"
  mkfs.ext4 -F /dev/nvme0n1 || true
  mkdir -p /srv/models
  mount /dev/nvme0n1 /srv/models || true
  chmod 0777 /srv/models
fi
mkdir -p /srv/models /opt/roboqc-testbed

# 2. Авторизация Docker в Artifact Registry.
gcloud auth configure-docker ${region}-docker.pkg.dev --quiet || true

# 3. Клонируем репозиторий с compose.gpu.yml.
if [ ! -d /opt/roboqc-testbed/.git ]; then
  git clone --depth=1 --branch "${compose_ref}" "${compose_repo_url}" /opt/roboqc-testbed
else
  cd /opt/roboqc-testbed && git fetch --depth=1 origin "${compose_ref}" && git checkout "${compose_ref}" && git pull --ff-only
fi
cd /opt/roboqc-testbed

# 4. Синхронизируем модели из GCS, если есть.
if [ -n "${models_bucket}" ]; then
  echo "[roboqc-startup] syncing models from gs://${models_bucket}"
  gsutil -m rsync -r "gs://${models_bucket}/" /srv/models/ || echo "[roboqc-startup] models bucket empty/inaccessible — SGLang скачает с HF"
fi

# 5. .env для compose.gpu.yml.
cat > /opt/roboqc-testbed/.env.testbed <<EOF
MODELS_DIR=/srv/models
PRIMARY_MODEL_ID=${primary_model_repo_id}
SECONDARY_MODEL_ID=${secondary_model_repo_id}
VISION_MODEL_ID=${vision_model_repo_id}
SGLANG_BASE_URL=http://sglang-qwen:30000/v1
SGLANG_VISION_BASE_URL=http://sglang-vision:30002/v1
RHAEF_BACKEND=sglang
ROBOQC_MODELS_BUCKET=gs://${models_bucket}
EOF

# 6. Поднимаем SGLang + supervisor.
docker compose --env-file /opt/roboqc-testbed/.env.testbed -f /opt/roboqc-testbed/compose.gpu.yml pull || true
docker compose --env-file /opt/roboqc-testbed/.env.testbed -f /opt/roboqc-testbed/compose.gpu.yml up -d sglang-qwen rhaef-supervisor

# 7. Включаем Ops Agent (если ещё не включён).
if ! systemctl is-active --quiet google-cloud-ops-agent; then
  curl -sS https://dl.google.com/cloudagents/add-google-cloud-ops-agent-repo.sh | bash -s -- --also-install || true
fi

echo "[roboqc-startup] $(date -u) done"
