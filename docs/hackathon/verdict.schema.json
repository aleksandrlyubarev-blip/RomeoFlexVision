{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/inspection-copilot/verdict.schema.json",
  "title": "InspectionVerdict",
  "description": "Structured output contract for the GPT-5.6 vision verdict in Inspection Copilot. Copy this file into the new repo as schemas/verdict.schema.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "defect_class", "confidence", "evidence_regions", "reasoning"],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["pass", "fail", "needs_review"],
      "description": "needs_review is mandatory when confidence < 0.7 or the defect_class is 'other'."
    },
    "defect_class": {
      "type": "string",
      "enum": [
        "none",
        "missing_screw",
        "loose_or_misrouted_cable",
        "misaligned_connector",
        "unlatched_latch",
        "solder_defect",
        "foreign_object",
        "surface_damage",
        "other"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "evidence_regions": {
      "type": "array",
      "maxItems": 5,
      "description": "Empty array when verdict is 'pass'.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "bbox"],
        "properties": {
          "label": { "type": "string", "maxLength": 60 },
          "bbox": {
            "type": "array",
            "description": "Normalized [x0, y0, x1, y1], origin top-left, values in 0..1.",
            "items": { "type": "number", "minimum": 0, "maximum": 1 },
            "minItems": 4,
            "maxItems": 4
          },
          "note": { "type": "string", "maxLength": 200 }
        }
      }
    },
    "reasoning": {
      "type": "string",
      "maxLength": 500,
      "description": "Short operator-facing explanation. Not chain-of-thought; two or three sentences."
    }
  }
}
