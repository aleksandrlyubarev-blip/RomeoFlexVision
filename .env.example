ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-proj-...
OPENROUTER_API_KEY=sk-or-...
XAI_API_KEY=xai-...
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls_...

# --- RoboQC testbed (опционально) -----------------------------------
# Локальный SGLang OpenAI-совместимый endpoint. Используется, когда в ModelRouter
# роутятся ROBOQC_VISION / ROBOQC_REASONING / ROBOQC_ACTION (модели *-local).
SGLANG_BASE_URL=http://localhost:30000/v1
SGLANG_VISION_BASE_URL=http://localhost:30002/v1
SGLANG_GEMMA_BASE_URL=http://localhost:30001/v1

# Бэкенд супервайзера: cloud (дефолт) или sglang.
RHAEF_BACKEND=cloud

# GCS-бакет с моделями и фикстурами полигона.
ROBOQC_MODELS_BUCKET=gs://<project>-roboqc-models
