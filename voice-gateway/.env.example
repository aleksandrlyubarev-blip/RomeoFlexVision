# Voice provider for the browser gateway: gemini (default) | grok
VOICE_PROVIDER=gemini

# --- Grok Voice (VOICE_PROVIDER=grok) ---

# xAI API key from https://console.x.ai/
XAI_API_KEY=
# Realtime voice model alias
GROK_VOICE_MODEL=grok-voice-latest
# Built-in voices: eve | ara | rex | sal | leo (or a custom voice ID)
GROK_VOICE=rex

# --- Gemini Live (VOICE_PROVIDER=gemini) ---

# Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Live model — update to the latest available Live model
# Candidates: gemini-2.0-flash-live-001 | gemini-live-2.5-flash-preview-native-audio-dialog
GEMINI_MODEL=gemini-2.0-flash-live-001

# Gateway listen port
PORT=8765

# Comma-separated allowed browser origins for CORS / WS upgrade
ALLOWED_ORIGINS=http://localhost:5173,https://romeoflexvision.com

# --- Remote MCP server (xAI Voice Agent Builder integration) ---

# MCP server listen port (POST /mcp, Streamable HTTP)
MCP_PORT=8766

# Bearer token the MCP caller must present. Leave empty to disable auth (local dev only).
# In the Voice Agent Builder tool config, set "authorization": "Bearer <this value>".
MCP_AUTH_TOKEN=
