# Скопируйте этот файл в terraform.tfvars и заполните под свой GCP-проект.
# terraform.tfvars в .gitignore — секреты в репозиторий не коммитятся.

project_id = "my-gcp-project-id"
region     = "us-central1"

# AI-сотрудники, которых разворачиваем в Cloud Run
# (имена = папки в larmorsight-office/employees/):
active_employees = ["research-analyst"]

# Docker-образ рантайма сотрудника. Соберите из gcp-infra/employee-runtime/Dockerfile
# и запушьте в Artifact Registry, затем раскомментируйте и укажите его здесь.
# Пока строка ниже закомментирована, используется публичный hello-образ Cloud Run.
# employee_image = "us-central1-docker.pkg.dev/my-gcp-project-id/larmorsight/larmorsight-employee:latest"

# --- опционально ---
# skills_bucket          = "my-gcp-project-id-larmorsight-skills"
# allow_unauthenticated  = false
# employee_cpu           = "1"
# employee_memory        = "512Mi"
# employee_max_instances = 3
# enable_scheduler       = false
# schedule_cron          = "0 9 * * 1"   # каждый понедельник 09:00 UTC

# Ключ Anthropic лучше не хранить в этом файле, а завести версию секрета вручную:
#   gcloud secrets versions add larmorsight-anthropic-api-key --data-file=- <<< "$ANTHROPIC_API_KEY"
# anthropic_api_key = "sk-ant-..."

# --- RoboQC GPU testbed (опционально) ---------------------------------
# Раскомментируйте блок ниже, чтобы поднять A100 80GB в europe-west4 + бакет моделей + Artifact Registry.
# Без этого блока тестовый полигон не создаётся и Cloud Run-сотрудники остаются нетронутыми.
#
# enable_testbed             = true
# testbed_region             = "europe-west4"
# testbed_zone               = "europe-west4-b"
# gpu_machine_type           = "a2-ultragpu-1g"     # 1x A100 80GB
# gpu_accelerator_type       = "nvidia-a100-80gb"
# gpu_accelerator_count      = 1
# use_spot                   = true                  # ~70% дешевле, может preempt'иться
# testbed_monthly_budget_usd = 2500
# testbed_auto_shutdown_cron = "0 19 * * *"          # стоп в 19:00 UTC каждый день
# testbed_auto_start_cron    = "0 7 * * 1-5"         # старт в 07:00 UTC пн-пт
# testbed_allowed_cidrs      = ["35.235.240.0/20"]   # только IAP. Добавьте свой office IP при необходимости.
